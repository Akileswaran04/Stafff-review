# Server only — never prefix with NEXT_PUBLIC_, never commit the real values (.env.local is gitignored).
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Mixed into every login code before hashing. Required by src/lib/staff-directory.ts and by
# scripts/generate-staff-directory.mjs (which must be run with the SAME value, or every hash
# in src/lib/staff-directory.data.ts stops matching and no one can log in).
PORTAL_LOGIN_PEPPER=

# Signs the session cookie (HMAC) so a forged/edited cookie is rejected even though the staff id
# inside it isn't secret.
SESSION_SECRET=
